---
import '../styles/global.css';
import BaseHead from './BaseHead.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  mdPath?: string;
  ogType?: 'website' | 'article' | 'profile';
  isHome?: boolean;
  article?: { date?: string; modified?: string; tags?: string[] };
}

const { isHome = false, ...rest } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead isHome={isHome} {...rest} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={['page-main', { 'home-page': isHome }]} tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
