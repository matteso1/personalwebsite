---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import portrait from '../assets/portrait-close.jpg';
import { LINKS } from '../lib/site';

const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('The homepage content is missing.');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} mdPath="/index.md" isHome>
  <section class="home-hero" aria-labelledby="hello">
    <div class="hero-copy">
      <p class="eyebrow">Inference engineering</p>
      <h1 id="hello">Hi, I'm Nils.</h1>
      <p class="home-intro">{entry.data.intro}</p>
      <div class="hero-links">
        <a href={LINKS.github}>GitHub <span aria-hidden="true">↗</span></a>
        <a href={LINKS.email}>Email <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <Image
      src={portrait}
      alt="Nils by the waterfront"
      widths={[240, 480]}
      sizes="(max-width: 767px) 120px, 208px"
      width={240}
      height={288}
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
  </section>
  <div class="home-prose prose">
    <Content />
  </div>
</BaseLayout>
