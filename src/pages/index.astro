---
import { getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';

const entry = await getEntry('pages', 'index');
---

<BaseLayout
  title={entry!.data.title}
  description={entry!.data.description}
  mdPath="/index.md"
  isHome
  noWrap
>

  <div style="max-width:920px;margin:0 auto;padding:16px 12px;">

    <!-- Marquee strip -->
    <Marquee />

    <div style="height:18px;"></div>

    <!-- Window 1: README.txt -->
    <div class="window bevel-out">
      <div class="titlebar">
        <span class="titlebar-title">README.txt - Notepad</span>
        <div class="titlebar-btns">
          <span class="tbtn" aria-hidden="true">_</span>
          <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
          <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
        </div>
      </div>
      <div class="menubar" aria-hidden="true">
        <span class="menubar-item">File</span>
        <span class="menubar-item">Edit</span>
        <span class="menubar-item">Search</span>
        <span class="menubar-item">Help</span>
      </div>
      <div class="window-body doc">
        <h1>Nils Matteson</h1>
        <p>I'm into inference engineering. I like making models faster to start and understanding where the time goes.</p>
        <p>I've been working on <a href="https://github.com/vllm-project/vllm">vLLM</a> through an Inferact-sponsored open-source fellowship with Simon Mo. Most of my time goes into what happens before a model serves its first request: loading weights, compiling code, tuning kernels, and deciding which of that work we can reuse.</p>
        <p>I'm interested in GPU memory, caching, and the less obvious reasons a system is slow. I like following a problem through the stack, making a change, and checking whether it helped for the reason I thought it would.</p>
        <p>I'm in San Jose, studying CS at Northeastern after finishing at UW-Madison. Outside of that, I make music in Ableton, play guitar, run, and ski when I can.</p>
        <p>
          mail <a href="mailto:nilsmatteson@icloud.com">nilsmatteson@icloud.com</a> &nbsp;&middot;&nbsp;
          code <a href="https://github.com/matteso1">github.com/matteso1</a> &nbsp;&middot;&nbsp;
          <a href="/resume.pdf">resume.pdf</a>
        </p>
      </div>
    </div>

    <div style="height:18px;"></div>

    <!-- Window 2: current inference work -->
    <div class="window bevel-out">
      <div class="titlebar">
        <span class="titlebar-title">inference.txt - Notepad</span>
        <div class="titlebar-btns">
          <span class="tbtn" aria-hidden="true">_</span>
          <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
          <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
        </div>
      </div>
      <div class="window-body">
        <p>
          Lately I've worked on <a href="https://github.com/vllm-project/vllm/pull/51360">reusable engine snapshots</a>
          and <a href="https://github.com/vllm-project/vllm/pull/55422">Python startup</a> in vLLM.
          Right now I'm looking at <a href="https://github.com/flashinfer-ai/flashinfer/pull/6032">MoE kernel tuning</a>
          in FlashInfer and how to reuse preparation across compatible model servers.
          A few questions I keep coming back to:
        </p>
        <div class="field" style="padding:8px 10px;margin-bottom:10px;">
          <table class="numbers-table" style="width:100%;border-collapse:collapse;">
            <tbody>
              <tr>
                <td style="padding:2px 10px 2px 2px;font-weight:bold;font-family:'Courier New',monospace;white-space:nowrap;border:none;">startup</td>
                <td style="padding:2px 6px;border:none;color:#808080;">what happens before the first useful response?</td>
              </tr>
              <tr>
                <td style="padding:2px 10px 2px 2px;font-weight:bold;font-family:'Courier New',monospace;white-space:nowrap;border:none;">model loading</td>
                <td style="padding:2px 6px;border:none;color:#808080;">getting weights from storage into GPU memory</td>
              </tr>
              <tr>
                <td style="padding:2px 10px 2px 2px;font-weight:bold;font-family:'Courier New',monospace;white-space:nowrap;border:none;">reusable state</td>
                <td style="padding:2px 6px;border:none;color:#808080;">which work can the next server safely skip?</td>
              </tr>
              <tr>
                <td style="padding:2px 10px 2px 2px;font-weight:bold;font-family:'Courier New',monospace;white-space:nowrap;border:none;">kernel tuning</td>
                <td style="padding:2px 6px;border:none;color:#808080;">finding good choices without repeating the search</td>
              </tr>
              <tr>
                <td style="padding:2px 10px 2px 2px;font-weight:bold;font-family:'Courier New',monospace;white-space:nowrap;border:none;">measurement</td>
                <td style="padding:2px 6px;border:none;color:#808080;">checking why a change made something faster</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="btn-row">
          <a href="/work" class="btn">Current work</a>
          <a href="https://github.com/vllm-project/vllm/pulls?q=is%3Apr+author%3Amatteso1" class="btn">vLLM</a>
          <a href="https://github.com/flashinfer-ai/flashinfer/pull/6032" class="btn">FlashInfer</a>
        </div>
      </div>
    </div>

    <div style="height:18px;"></div>

    <!-- Window 3: the paper -->
    <div class="window bevel-out">
      <div class="titlebar">
        <span class="titlebar-title">Re-feeding Is Not Replaying.pdf - Acrobat Reader</span>
        <div class="titlebar-btns">
          <span class="tbtn" aria-hidden="true">_</span>
          <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
          <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
        </div>
      </div>
      <div class="window-body">
        <p>
          <strong>Re-feeding Is Not Replaying: Measuring Replay Noise in Counterfactual Token-Credit Estimation</strong><br>
          <span style="color:#808080;">sole-author preprint &middot; <a href="https://arxiv.org/abs/2606.15621">arXiv:2606.15621</a> &middot; June 2026</span>
        </p>
        <p>
          I looked at whether resuming a model's saved decoder state produces the same measurements as
          feeding the text back in. The experiments compare both against repeated runs, separating replay
          differences from run-to-run noise. The writeup includes the setup, results, and cases where the
          distinction disappears.
        </p>
        <p style="color:#808080;">The paper, experiment logs, and analysis code are public.</p>
        <div class="btn-row">
          <a href="https://arxiv.org/abs/2606.15621" class="btn">Read on arXiv</a>
          <a href="/refeed-drift.pdf" class="btn">PDF</a>
          <a href="https://github.com/thaw-ai/thaw/tree/main/paper/refeed-drift" class="btn">Data + harness</a>
        </div>
      </div>
    </div>

    <div style="height:18px;"></div>

    <!-- Window 4: File Explorer -->
    <div class="window bevel-out">
      <div class="titlebar">
        <span class="titlebar-title">Exploring - C:\nils</span>
        <div class="titlebar-btns">
          <span class="tbtn" aria-hidden="true">_</span>
          <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
          <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
        </div>
      </div>
      <div class="menubar" aria-hidden="true">
        <span class="menubar-item">File</span>
        <span class="menubar-item">Edit</span>
        <span class="menubar-item">View</span>
        <span class="menubar-item">Go</span>
        <span class="menubar-item">Help</span>
      </div>
      <div class="window-body doc" style="padding:0;">
        <table class="explorer-table">
          <thead>
            <tr>
              <th style="width:42%;">Name</th>
              <th style="width:18%;">Type</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="name-cell">
                <a href="/work#vllm-upstream--fellowship">
                  <span class="icon-folder" aria-hidden="true"></span>work\vllm
                </a>
              </td>
              <td>File Folder</td>
              <td>startup, model loading, reusable engine state</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="https://github.com/flashinfer-ai/flashinfer/pull/6032">
                  <span class="icon-folder" aria-hidden="true"></span>work\flashinfer
                </a>
              </td>
              <td>File Folder</td>
              <td>MoE kernel tuning and cache reuse</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/work/sentinel">
                  <span class="icon-folder" aria-hidden="true"></span>work\sentinel
                </a>
              </td>
              <td>File Folder</td>
              <td>Go log engine, LSM + Raft</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/work/madison-metro-ml">
                  <span class="icon-folder" aria-hidden="true"></span>work\madison-metro-ml
                </a>
              </td>
              <td>File Folder</td>
              <td>transit ETAs and uncertainty</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/writing/echo-and-the-engineer">
                  <span class="icon-file" aria-hidden="true"></span>writing\echo-and-the-engineer.md
                </a>
              </td>
              <td>Markdown</td>
              <td>essay: sycophancy, RLHF, the half-life of a belief</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/writing/project-gorgon">
                  <span class="icon-file" aria-hidden="true"></span>writing\project-gorgon.md
                </a>
              </td>
              <td>Markdown</td>
              <td>speculative decoding at 0.66x of baseline, negative result</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/writing/madison-bus-eta">
                  <span class="icon-file" aria-hidden="true"></span>writing\madison-bus-eta.md
                </a>
              </td>
              <td>Markdown</td>
              <td>the transit-ETA writeup</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/writing/wattbot-rag">
                  <span class="icon-file" aria-hidden="true"></span>writing\wattbot-rag.md
                </a>
              </td>
              <td>Markdown</td>
              <td>RAG benchmarks, 282 questions</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/refeed-drift.pdf">
                  <span class="icon-file" aria-hidden="true"></span>refeed-drift.pdf
                </a>
              </td>
              <td>Adobe Acrobat Document</td>
              <td>inference-state replay experiments</td>
            </tr>
            <tr>
              <td class="name-cell">
                <a href="/agents">
                  <span class="icon-file" aria-hidden="true"></span>agents.txt
                </a>
              </td>
              <td>Text Document</td>
              <td>facts for LLMs</td>
            </tr>
          </tbody>
        </table>
        <div class="statusbar">
          <span class="statusbar-panel">10 object(s)</span>
        </div>
      </div>
    </div>

    <div style="height:18px;"></div>

    <!-- Window 5+6: System Properties + New Message, side by side -->
    <div class="window-row">

      <!-- System Properties (narrow) -->
      <div class="window bevel-out window-narrow">
        <div class="titlebar">
          <span class="titlebar-title">System Properties</span>
          <div class="titlebar-btns">
            <span class="tbtn" aria-hidden="true">_</span>
            <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
            <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
          </div>
        </div>
        <div class="window-body">
          <div class="field sysprop-field">
            <p><strong>System:</strong> B.S. Data Science, UW-Madison (May 2026)</p>
            <p><strong>System:</strong> M.S. CS, Northeastern Silicon Valley (Sep 2026 - May 2028)</p>
            <p><strong>Registered to:</strong> Nils Matteson, San Jose CA</p>
            <p><strong>Running:</strong> vLLM open-source fellowship, sponsored by Inferact (Jul 2026 - present): cold start and reusable engine state</p>
            <p><strong>Interests:</strong> GPU memory, model loading, caches, and measurement</p>
            <p><strong>Off the clock:</strong> music, guitar, running, skiing</p>
          </div>
          <div class="btn-row">
            <a href="mailto:nilsmatteson@icloud.com" class="btn">OK</a>
            <a href="/" class="btn" title="you can't escape">Cancel</a>
          </div>
        </div>
      </div>

      <!-- New Message (mail) -->
      <div class="window bevel-out window-narrow mailwin">
        <div class="titlebar">
          <span class="titlebar-title">New Message - Outlook Express</span>
          <div class="titlebar-btns">
            <span class="tbtn" aria-hidden="true">_</span>
            <span class="tbtn" aria-hidden="true" style="font-size:8px;">&#9633;</span>
            <a href="/" class="tbtn" title="close (go home)" aria-label="Close">&#x2715;</a>
          </div>
        </div>
        <div class="menubar" aria-hidden="true">
          <span class="menubar-item">File</span>
          <span class="menubar-item">Edit</span>
          <span class="menubar-item">Insert</span>
          <span class="menubar-item">Help</span>
        </div>
        <div class="window-body">
          <div class="mail-toolbar">
            <a
              id="mail-send"
              href="mailto:nilsmatteson@icloud.com?subject=shoot%20you%20an%20electronic%20message%20on%20the%20net"
              class="btn mail-send"
              title="Send mail"
            >
              <span class="mail-send-ico" aria-hidden="true"></span>Send
            </a>
          </div>
          <div class="field mail-headers">
            <div class="mail-hrow">
              <span class="mail-hlabel">To:</span>
              <span class="mail-hval">
                <select id="mail-to" class="mail-select" aria-label="Recipient address">
                  <option value="nilsmatteson@icloud.com">nilsmatteson@icloud.com</option>
                  <option value="matteson.ni@northeastern.edu">matteson.ni@northeastern.edu</option>
                </select>
              </span>
            </div>
            <div class="mail-hrow">
              <span class="mail-hlabel">Subject:</span>
              <span class="mail-hval">shoot you an electronic message on the net</span>
            </div>
          </div>
          <div class="field mail-compose">
            <p class="mail-quote">"Every program attempts to expand until it can read mail. Those which cannot are replaced by ones which can."</p>
            <p class="mail-sig">--<br />Zawinski's Law, 1995</p>
            <p class="mail-wink">(you are reading this inside exactly such a program)</p>
          </div>
        </div>
        <script>
          const mailSel = document.getElementById('mail-to');
          const mailSend = document.getElementById('mail-send');
          const mailSubject = 'shoot%20you%20an%20electronic%20message%20on%20the%20net';
          mailSel?.addEventListener('change', () => {
            mailSend.setAttribute('href', `mailto:${mailSel.value}?subject=${mailSubject}`);
          });
        </script>
      </div>

    </div>

    <div style="height:18px;"></div>

    <!-- Counter + badges strip (on teal, no window) -->
    <div class="counter-strip">
      <span class="counter-label">you are visitor</span>
      <div class="counter-well">
        <span class="counter-digits">016,384</span>
      </div>
      <span class="counter-caption">(counter is static. no js, no tracking.)</span>
      <div class="badges">
        <span class="badge88 badge88-logo" style="background:#7a2a1f;color:#ffd9cf;">
          <i class="logo-ico" style="width:16px;height:16px;--ico:url(/logos/rust.svg)"></i>RUST INSIDE
        </span>
        <span class="badge88" style="background:#0b3d0b;color:#aaffaa;">CUDA 12+</span>
        <a href="https://github.com/vllm-project/vllm/pulls?q=is%3Apr+is%3Amerged+author%3Amatteso1" class="badge88" style="background:#001a4d;color:#9fc3ff;text-decoration:none;" title="Upstream vLLM contributions">vLLM UPSTREAM</a>
        <a href="https://arxiv.org/abs/2606.15621" class="badge88 badge88-logo" style="background:#fff;text-decoration:none;gap:3px;" title="Re-feeding Is Not Replaying — arXiv:2606.15621 (cs.LG)">
          <img src="/logos/arxiv.svg" alt="arXiv" style="height:13px;" />
          <small style="font-family:'Courier New',monospace;color:#b31b1b;font-size:8px;">.15621</small>
        </a>
        <a href="https://github.com/matteso1" class="badge88 badge88-logo" style="background:#161614;color:#e8e8e8;text-decoration:none;">
          <i class="logo-ico" style="width:14px;height:14px;--ico:url(/logos/github.svg)"></i>SOURCE
        </a>
        <a href="https://pypi.org/project/vllm/" class="badge88 badge88-logo" style="background:#003a6b;color:#ffd43b;text-decoration:none;">
          <i class="logo-ico" style="width:14px;height:14px;--ico:url(/logos/pypi.svg)"></i>pip install
        </a>
        <span class="badge88" style="background:#3d2b00;color:#ffe08a;">OPEN SOURCE</span>
        <span class="badge88" style="background:#000;color:#00ff00;">Y2K COMPLIANT</span>
        <span class="badge88" style="background:#1a1a4d;color:#cfcfff;font-size:9px;">BEST VIEWED IN NETSCAPE 4.0</span>
        <a href="http://iymyzmzwmsfg2zah6ecb64rsw63agex4zsnh3j4xqx6mq52ucpfxfvad.onion" class="badge88 badge88-logo" style="background:#fff;color:#7d4fb0;" title="Tor — iymyzmzwmsfg2zah6ecb64rsw63agex4zsnh3j4xqx6mq52ucpfxfvad.onion (open in Tor Browser)">
          <img src="/logos/tor.svg" alt="Tor" style="height:21px;" />
          <span class="b88-txt" style="font-family:Helvetica,Arial,sans-serif;">Tor<br /><small style="font-family:'Courier New',monospace;">.onion</small></span>
        </a>
        <a href="http://64tue5hr36bf67bryxjyium2gzi7bbobvdutfsjylqowwcv3po3q.b32.i2p" class="badge88 badge88-logo" style="background:#fff;color:#111;" title="I2P — 64tue5hr36bf67bryxjyium2gzi7bbobvdutfsjylqowwcv3po3q.b32.i2p (open via I2P proxy)">
          <img src="/logos/i2p.svg" alt="I2P" style="height:19px;" />
          <span class="b88-txt" style="font-family:Helvetica,Arial,sans-serif;">I2P<br /><small style="font-family:'Courier New',monospace;">eepsite</small></span>
        </a>
      </div>
    </div>

    <div style="height:8px;"></div>

  </div>

</BaseLayout>
