---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', year: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title="Writing" description="Notes by Nils Matteson on inference systems, experiments, and things that did or didn't work.">
  <h1>Writing</h1>
  <p class="writing-intro">Notes on things I've built, experiments I've run, and what I learned along the way.</p>
  <ul class="writing-list">
    {posts.map((post) => (
      <li>
        <a href={'/writing/' + post.id}>
          <h2>{post.data.title}</h2>
          {post.data.description && <p>{post.data.description}</p>}
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
