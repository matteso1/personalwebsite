---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-close.jpg';
import { SITE } from '../lib/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{SITE.name} social image</title>
    <style is:global>
      * { margin: 0; box-sizing: border-box; }
      html, body { background: #faf9f6; }
      .card {
        width: 1200px;
        height: 630px;
        color: #282823;
        padding: 76px 80px 54px;
        display: grid;
        grid-template-columns: 1fr 216px;
        align-content: space-between;
        gap: 50px;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
      .label { color: #a0442b; font-size: 22px; margin-bottom: 30px; }
      h1 { font-size: 76px; font-weight: 500; letter-spacing: -4px; line-height: 1.1; margin-bottom: 30px; }
      .intro { color: #4a4a43; font-size: 30px; line-height: 1.5; max-width: 620px; }
      img { width: 216px; height: 260px; object-fit: cover; border-radius: 5px; align-self: center; }
      .url { grid-column: 1 / -1; border-top: 1px solid #deded5; padding-top: 25px; font-size: 21px; color: #737369; }
    </style>
  </head>
  <body>
    <main class="card">
      <div>
        <p class="label">Inference engineering</p>
        <h1>{SITE.name}</h1>
        <p class="intro">Making models faster to start.<br />Understanding where the time goes.</p>
      </div>
      <Image src={portrait} width={432} height={518} alt="Nils by the waterfront" loading="eager" />
      <p class="url">nilsmatteson.com</p>
    </main>
  </body>
</html>
